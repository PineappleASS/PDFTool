# OpenAI API Configuration
OPENAI_API_KEY=your_api_key_here
OPENAI_MODEL=gpt-4o

# Model Options (cost vs quality trade-off):
# - o1-mini or o5-mini: Cheapest, great reasoning, good quality (~$0.05 for 10 pages)
# - gpt-4o-mini: Very cheap, good quality (~$0.03 for 10 pages)  
# - gpt-4o: Best quality, more expensive (~$0.15 for 10 pages)
# Note: o1/o5 models only support temperature=1 (handled automatically)

# PDF Processing
PDF_RENDER_SCALE=1.5
MAX_PAGES_PER_RUN=20

# Vision Processing (Token Optimization)
VISION_IMAGE_MAX_SIZE=1024
VISION_IMAGE_QUALITY=75
VISION_DETAIL_LEVEL=low
MAX_TEXT_CONTEXT_LENGTH=500

# Output Token Reduction
MAX_FACTS_PER_PAGE=5
MAX_VISUALS_PER_PAGE=3
MAX_GAPS_PER_PAGE=3

# OCR Configuration
TESSERACT_LANGUAGES=ara+eng

# Quality Control
RETRY_FLAGGED_PAGES=true
RETRY_SCALE_MULTIPLIER=1.5

# Validation
MIN_TITLE_LENGTH=3
MAX_BRAND_REPETITION=5

# Windows-specific paths (uncomment and set if needed)
# POPPLER_PATH=C:\Program Files\poppler\Library\bin
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
